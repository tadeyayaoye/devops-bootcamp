# Copie en ci/.env (ignoré par Git) et remplis. Ces valeurs sont injectées dans Jenkins par JCasC.

# GID du groupe docker de l'hôte : getent group docker | cut -d: -f3
DOCKER_GID=999

# Compte admin Jenkins (openssl rand -hex 12)
JENKINS_ADMIN_PASSWORD=change-moi

# Token GitHub CLASSIC avec les scopes : repo (ou public_repo) + write:packages
# (module 07 : push d'image sur GHCR ; module 08 : commit dans le repo GitOps)
GITHUB_USER=tadeyayaoye
GITHUB_TOKEN=

# Token SonarQube (module 07) : My Account → Security → Generate token (type "Global analysis")
SONAR_TOKEN=
