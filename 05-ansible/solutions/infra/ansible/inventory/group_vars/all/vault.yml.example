# Modèle EN CLAIR du fichier vault.yml. Ne commite jamais vault.yml non chiffré !
#   cp vault.yml.example vault.yml
#   ansible-vault encrypt vault.yml        (utilise .vault_pass grâce à ansible.cfg)
#   ansible-vault view vault.yml
# Convention : préfixer les variables chiffrées par vault_ et les référencer depuis main.yml
vault_db_password: "a-remplacer"
